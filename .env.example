# Public web origin used for auth redirects and same-origin validation.
AIRPORT_CHAOS_WEB_ORIGIN=https://your-game.example

# Google OAuth credentials. Copy real values into the ignored root .env only.
AIRPORT_CHAOS_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AIRPORT_CHAOS_GOOGLE_CLIENT_SECRET=your-google-client-secret
AIRPORT_CHAOS_GOOGLE_REDIRECT_URI=https://your-api.example/api/auth/oauth/google/callback
# Public iOS OAuth client ID. Native Google still issues backend ID tokens to
# AIRPORT_CHAOS_GOOGLE_CLIENT_ID; no native client secret belongs in the app.
AIRPORT_CHAOS_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Apple Sign in credentials. Copy real values into the ignored root .env only.
AIRPORT_CHAOS_APPLE_CLIENT_ID=your-apple-service-id
AIRPORT_CHAOS_APPLE_TEAM_ID=your-apple-team-id
AIRPORT_CHAOS_APPLE_KEY_ID=your-apple-key-id
AIRPORT_CHAOS_APPLE_PRIVATE_KEY=your-apple-private-key
AIRPORT_CHAOS_APPLE_REDIRECT_URI=https://your-api.example/api/auth/oauth/apple/callback
