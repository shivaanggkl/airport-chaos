# Public web origin used for auth redirects and same-origin validation.
AIRPORT_CHAOS_WEB_ORIGIN=https://your-game.example

# Google OAuth credentials. Copy real values into the ignored root .env only.
AIRPORT_CHAOS_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
AIRPORT_CHAOS_GOOGLE_CLIENT_SECRET=your-google-client-secret
AIRPORT_CHAOS_GOOGLE_REDIRECT_URI=https://your-api.example/api/auth/oauth/google/callback
# Public iOS OAuth client ID. Native Google still issues backend ID tokens to
# AIRPORT_CHAOS_GOOGLE_CLIENT_ID; no native client secret belongs in the app.
AIRPORT_CHAOS_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Apple Sign in credentials. Copy real values into the ignored root .env only.
AIRPORT_CHAOS_APPLE_CLIENT_ID=your-apple-service-id
AIRPORT_CHAOS_APPLE_TEAM_ID=your-apple-team-id
AIRPORT_CHAOS_APPLE_KEY_ID=your-apple-key-id
AIRPORT_CHAOS_APPLE_PRIVATE_KEY=your-apple-private-key
AIRPORT_CHAOS_APPLE_REDIRECT_URI=https://your-api.example/api/auth/oauth/apple/callback

# Firehawk Web checkout. Stripe secrets and immutable Price IDs are server-only.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_FIREHAWK_PRICE_ID=price_your-24-usd-firehawk-price-id

# StoreKit 2 server verification. Root certificates are Apple's public DER
# roots encoded as comma-separated base64; the App Apple ID is numeric.
AIRPORT_CHAOS_APPLE_IAP_ENVIRONMENT=sandbox
AIRPORT_CHAOS_APPLE_IAP_APP_APPLE_ID=your-numeric-app-apple-id
AIRPORT_CHAOS_APPLE_IAP_ROOT_CERTIFICATES_BASE64=base64-apple-root-ca-der

# Google Play verification credentials are server-only. Use one-line JSON in
# the ignored .env/host secret store; never bundle this value in Android.
AIRPORT_CHAOS_GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"placeholder","private_key":"placeholder","client_email":"placeholder"}
AIRPORT_CHAOS_GOOGLE_PLAY_PUBSUB_AUDIENCE=https://your-api.example/api/store/google/notifications
AIRPORT_CHAOS_GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT=play-notifications@your-project.iam.gserviceaccount.com
